# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables (hosted).

# Neon Postgres (the pooled "-pooler" connection string)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Login. Generate the secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's address: http://localhost:3000 locally, https://your-app.vercel.app when hosted
BETTER_AUTH_URL=http://localhost:3000

# Private file storage (Backblaze B2 or any S3-compatible store). Bucket must be PRIVATE;
# use a key limited to this bucket (B2's master key doesn't work with the S3 API).
S3_ENDPOINT=https://s3.REGION.backblazeb2.com
S3_REGION=REGION
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Python processor. Locally: http://localhost:8000 and no key needed.
# Hosted: the processor's URL, and the same long random key set on the processor (PROCESSOR_KEY).
PROCESSOR_URL=http://localhost:8000
PROCESSOR_KEY=

# Optional email through Gmail: the account address and a Google "app password"
# (Google Account → Security → 2-Step Verification → App passwords). Leave empty to send nothing.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who hears about new teacher sign-ups (comma-separated). Empty = every admin account.
ADMIN_EMAIL=
