{
  "name": "papersmith",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm run test -w web",
    "db:generate": "npm run db:generate -w web",
    "db:migrate": "npm run db:migrate -w web",
    "db:seed": "npm run db:seed -w web",
    "user:create": "npm run user:create -w web --",
    "processor": "cd services/processor && .venv/bin/uvicorn main:app --reload --port 8000"
  }
}
